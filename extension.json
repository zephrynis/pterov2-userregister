{
  "$schema": "./vendor/sdk/manifest.schema.json",
  "id": "userregister",
  "name": "UserRegister",
  "version": "1.0.1",
  "description": "Public account registration with optional email verification controlled by administrators.",
  "provider": "UserRegister\\UserRegisterProvider",
  "autoload": {
    "UserRegister\\": "src"
  },
  "requires": {
    "panel": ">=2.0.0-dev <2.0.0-beta.3",
    "sdk": ">=2.0.0-beta.6 <2.0.0-beta.7",
    "php": ">=8.3 <9"
  },
  "ui": {
    "entry": "dist/client.js",
    "mode": "native"
  }
}
